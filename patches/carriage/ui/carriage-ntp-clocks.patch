+/* Carriage: three retro wall clocks. */
+#carriageClocks {
+  display: flex;
+  gap: 56px;
+  justify-content: center;
+  margin-bottom: 48px;
+}
+
+.carriage-clock {
+  align-items: center;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.carriage-clock svg {
+  filter: drop-shadow(0 2px 3px rgba(43, 30, 22, 0.28));
+  height: 132px;
+  margin-bottom: 8px;
+  width: 132px;
+}
+
+.carriage-clock .ticks-minor,
+.carriage-clock .ticks-major {
+  fill: none;
+  stroke: #2A1F18;
+}
+
+.carriage-clock .ticks-minor {
+  stroke-width: 0.8;
+}
+
+.carriage-clock .ticks-major {
+  stroke-width: 2.4;
+}
+
+.carriage-clock .numerals text {
+  fill: #2A1F18;
+  font-family: 'Courier Prime', 'Courier New', Courier, monospace;
+  font-size: 12px;
+  font-weight: 700;
+  text-anchor: middle;
+}
+
+.carriage-clock .hand {
+  fill: #2A1F18;
+}
+
+.carriage-clock .seconds line {
+  stroke: #8A3E2C;
+  stroke-width: 0.8;
+}
+
+.carriage-clock .seconds circle {
+  fill: #8A3E2C;
+}
+
+.carriage-clock-city,
+.carriage-clock-time {
+  font-family: 'Courier Prime', 'Courier New', Courier, monospace;
+}
+
+.carriage-clock-city {
+  color: var(--cr-primary-text-color);
+  font-size: 13px;
+  font-weight: 700;
+  letter-spacing: 0.18em;
+  text-transform: uppercase;
+}
+
+.carriage-clock-time {
+  color: var(--cr-secondary-text-color);
+  font-size: 12px;
+  font-variant-numeric: tabular-nums;
+}
