+/* Carriage: Pullman carriage. Mahogany panelling, brass, and three arched
+   windows whose sky follows each city's time of day. */
+#carriagePanelling {
+  background:
+      repeating-linear-gradient(92deg, rgba(0, 0, 0, 0.1) 0 2px,
+                                transparent 2px 9px),
+      repeating-linear-gradient(88deg, rgba(255, 200, 150, 0.05) 0 1px,
+                                transparent 1px 23px),
+      linear-gradient(180deg, #3B1A10, #5A2A17 50%, #3B1A10);
+  inset: 0;
+  pointer-events: none;
+  position: fixed;
+  z-index: -1;
+}
+
+.carriage-brass-band {
+  background: linear-gradient(90deg, #6E5220, #E8CE86, #6E5220);
+  height: 3px;
+  left: 0;
+  position: absolute;
+  right: 0;
+}
+
+.carriage-brass-band.top {
+  top: 13%;
+}
+
+.carriage-brass-band.bottom {
+  bottom: 13%;
+}
+
+#carriagePlate {
+  background: linear-gradient(180deg, #F1D98F, #B8963F);
+  border-radius: 3px;
+  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.5), inset 0 1px 0 #FFF2C0;
+  color: #3B1A10;
+  font-family: Copperplate, Futura, 'Avenir Next', sans-serif;
+  font-size: 15px;
+  font-weight: 700;
+  letter-spacing: 0.5em;
+  margin-bottom: 44px;
+  padding: 9px 26px 8px 34px;
+}
+
+#carriageClocks {
+  display: flex;
+  gap: 64px;
+  justify-content: space-evenly;
+  margin-bottom: 52px;
+  width: min(1320px, 94vw);
+}
+
+.carriage-window {
+  background: linear-gradient(160deg, #F1D98F, #8C6A2C);
+  border-radius: 95px 95px 22px 22px;
+  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.55);
+  box-sizing: border-box;
+  height: 250px;
+  padding: 9px;
+  width: 190px;
+}
+
+.carriage-glass {
+  align-items: center;
+  border-radius: 86px 86px 16px 16px;
+  box-sizing: border-box;
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+  overflow: hidden;
+  padding-top: 22px;
+  position: relative;
+  width: 100%;
+}
+
+.carriage-glass.sky-night {
+  background: linear-gradient(180deg, #070C24, #18224F);
+}
+
+.carriage-glass.sky-dawn {
+  background: linear-gradient(180deg, #2B2357, #C9786A);
+}
+
+.carriage-glass.sky-day {
+  background: linear-gradient(180deg, #3E6FB3, #A9C7E8);
+}
+
+.carriage-glass.sky-dusk {
+  background: linear-gradient(180deg, #3A2E66, #E39A62);
+}
+
+.carriage-glass.sky-evening {
+  background: linear-gradient(180deg, #141A45, #4B3A7A);
+}
+
+.carriage-stars {
+  height: 100%;
+  inset: 0;
+  position: absolute;
+  width: 100%;
+}
+
+.carriage-stars path {
+  fill: none;
+  stroke: #FFF8E6;
+  stroke-linecap: round;
+}
+
+.carriage-stars .small {
+  opacity: 0.6;
+  stroke-width: 1.1;
+}
+
+.carriage-stars .large {
+  opacity: 0.9;
+  stroke-width: 2;
+}
+
+.sky-day .carriage-stars {
+  display: none;
+}
+
+.sky-dawn .carriage-stars,
+.sky-dusk .carriage-stars {
+  opacity: 0.45;
+}
+
+.carriage-dial {
+  filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.6));
+  height: 128px;
+  position: relative;
+  width: 128px;
+}
+
+.carriage-dial .arc {
+  fill: none;
+  stroke: #C9B27A;
+  stroke-width: 0.4;
+}
+
+.carriage-dial .ticks-minor,
+.carriage-dial .ticks-major {
+  fill: none;
+}
+
+.carriage-dial .ticks-minor {
+  stroke: #3B2A1A;
+  stroke-width: 0.45;
+}
+
+.carriage-dial .ticks-major {
+  stroke: #2A1A10;
+  stroke-width: 1.5;
+}
+
+.carriage-dial .numerals text {
+  fill: #2A1A10;
+  font-family: Didot, 'Bodoni 72', Georgia, serif;
+  font-size: 9.5px;
+  text-anchor: middle;
+}
+
+.carriage-dial .hand {
+  fill: #2A1A10;
+}
+
+.carriage-dial .seconds line {
+  stroke: #9E2B25;
+  stroke-width: 0.55;
+}
+
+.carriage-dial .seconds circle {
+  fill: #9E2B25;
+}
+
+.carriage-city,
+.carriage-time {
+  font-family: Futura, 'Avenir Next', 'Helvetica Neue', sans-serif;
+  position: relative;
+  text-shadow: 0 1px 3px rgba(20, 8, 4, 0.75);
+}
+
+.carriage-city {
+  color: #F6E7BC;
+  font-size: 12px;
+  font-weight: 600;
+  letter-spacing: 0.36em;
+  margin-top: 14px;
+  text-transform: uppercase;
+}
+
+.carriage-time {
+  color: #FFF1CC;
+  font-size: 12px;
+  font-variant-numeric: tabular-nums;
+  letter-spacing: 0.2em;
+  margin-top: 5px;
+}
