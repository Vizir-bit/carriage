+// Carriage: like Chrome and Brave, talk to the Chrome Web Store directly.
+// Helium's extension proxy is only used when the user explicitly turns it on.
+bool ShouldProxyExtensions(const PrefService& prefs) {
+    const PrefService::Preference* pref =
+        prefs.FindPreference(prefs::kHeliumExtProxyEnabled);
+    return ShouldAccessExtensionService(prefs) && pref &&
+           !pref->IsDefaultValue();
+}
